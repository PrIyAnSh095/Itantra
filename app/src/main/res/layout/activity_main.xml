<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Top App Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnOpenSettings">

                    <TextView
                        android:id="@+id/tvAppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/primary_blue"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-black"/>

                    <TextView
                        android:id="@+id/tvAppSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="normal"/>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnOpenSettings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/title_settings"
                    android:src="@android:drawable/ic_menu_preferences"
                    app:tint="@color/text_secondary" />
            </RelativeLayout>

            <!-- Network Status Bar & Offline Indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_disconnected"
                    android:text="@string/status_disconnected"
                    android:textColor="@color/state_gray"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvNetworkType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/network_wifi_hotspot"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvLocalNetworkBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_local"
                    android:text="@string/network_local"
                    android:textColor="@color/primary_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Transport Selection Toggle: Wi-Fi Hotspot vs Bluetooth P2P -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnTransportWifi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="📡 Wi-Fi Hotspot"
                    android:textSize="11sp"
                    android:textColor="@color/text_inverse"
                    android:backgroundTint="@color/primary_blue"
                    android:layout_marginEnd="3dp"
                    style="@style/Widget.MaterialComponents.Button"/>

                <Button
                    android:id="@+id/btnTransportBt"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="ᛒ Bluetooth P2P"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/bg_card_secondary"
                    android:layout_marginStart="3dp"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

            <!-- Emergency Alert Banner (Shown when alert received) -->
            <TextView
                android:id="@+id/tvAlertBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_alert_active_btn"
                android:text="@string/alert_banner"
                android:textColor="@color/text_inverse"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <!-- Languages Card: UI Language vs Communication Language -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Communication Language -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:id="@+id/tvLabelCommLang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_comm_language"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>

                            <Spinner
                                android:id="@+id/spinnerCommLang"
                                android:saveEnabled="false"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_selector_box"/>
                        </LinearLayout>

                        <!-- App UI Language -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:id="@+id/tvLabelAppLang"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_app_language"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="4dp"/>

                            <Spinner
                                android:id="@+id/spinnerAppLang"
                                android:saveEnabled="false"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_selector_box"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Model Status Indicator -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvModelStatusBadge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/model_loading"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="monospace"/>

                        <TextView
                            android:id="@+id/tvEngineInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IndicConformer · CPU"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <!-- Prominent Install / Download Model Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallModel"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="📥 Setup / Download Offline Model (~120 MB)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_inverse"
                        app:backgroundTint="@color/state_orange"
                        app:cornerRadius="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginTop="8dp"
                        android:visibility="visible"
                        style="@style/Widget.MaterialComponents.Button"/>

                    <!-- Main Screen Download Progress Bar -->
                    <LinearLayout
                        android:id="@+id/layoutMainDownloadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/pbMainDownload"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:progress="0"
                            android:max="100"
                            android:progressTint="@color/primary_blue"/>

                        <TextView
                            android:id="@+id/tvMainDownloadPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textColor="@color/primary_blue"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <!-- Voice Persona Selector Row -->
                    <LinearLayout
                        android:id="@+id/layoutVoiceRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_selector_box"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginTop="10dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗣️"
                            android:textSize="18sp"
                            android:layout_marginEnd="8dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Voice Persona"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvActiveVoiceName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Priya (Female)"
                                android:textColor="@color/primary_blue"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnPreviewVoiceMain"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Preview Voice"
                            android:src="@android:drawable/ic_lock_silent_mode_off"
                            app:tint="@color/primary_blue"
                            android:layout_marginEnd="6dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChangeVoice"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Change"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_blue"
                            app:backgroundTint="@color/primary_blue_light"
                            app:strokeColor="@color/primary_blue"
                            app:strokeWidth="1dp"
                            app:cornerRadius="6dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ROOM Card (HOST / JOIN) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Mode Toggle Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <Button
                            android:id="@+id/btnHostMode"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/mode_host"
                            android:textColor="@color/text_inverse"
                            android:backgroundTint="@color/primary_blue"
                            android:layout_marginEnd="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>

                        <Button
                            android:id="@+id/btnJoinMode"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/mode_join"
                            android:textColor="@color/text_secondary"
                            android:backgroundTint="@color/bg_card_secondary"
                            android:layout_marginStart="4dp"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>

                    <!-- Bluetooth Peer Selector Button (Shown when Bluetooth Join mode active) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectBtPeer"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:text="📱 Select Paired Peer Phone"
                        android:textColor="@color/primary_blue"
                        android:backgroundTint="@color/primary_blue_light"
                        android:textSize="12sp"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        style="@style/Widget.MaterialComponents.Button"/>

                    <!-- Room Code Row -->
                    <LinearLayout
                        android:id="@+id/layoutRoomCodeRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <EditText
                            android:id="@+id/etRoomCode"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:hint="@string/hint_room_code"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:background="@drawable/bg_input_field"
                            android:inputType="number"
                            android:maxLength="8"
                            android:textSize="15sp"
                            android:fontFamily="monospace"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btnGenerateCode"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="@string/btn_generate_code"
                            android:textColor="@color/primary_blue"
                            android:backgroundTint="@color/primary_blue_light"
                            style="@style/Widget.MaterialComponents.Button"/>
                    </LinearLayout>

                    <!-- Connect / Disconnect Action Button -->
                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/btn_connect"
                        android:textColor="@color/text_inverse"
                        android:backgroundTint="@color/primary_blue"
                        android:textStyle="bold"
                        style="@style/Widget.MaterialComponents.Button"/>

                    <!-- Detailed Status info -->
                    <TextView
                        android:id="@+id/tvRoomStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Conversation Display Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_conversation"
                        android:textColor="@color/primary_blue"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tvTranscriptEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/transcript_empty"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"/>

                    <!-- Outgoing Speech Transcript -->
                    <TextView
                        android:id="@+id/tvTranscriptYou"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:background="@drawable/bg_selector_box"
                        android:visibility="gone"
                        android:layout_marginBottom="6dp"/>

                    <!-- Incoming Speech Transcript -->
                    <TextView
                        android:id="@+id/tvTranscriptReceived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/state_green"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:padding="8dp"
                        android:background="@drawable/bg_selector_box"
                        android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Performance & Bandwidth Metrics Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_performance"
                        android:textColor="@color/primary_blue"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp"/>

                    <!-- 4 Latency Metrics Grid -->
                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="2">

                        <TextView
                            android:id="@+id/tvMetricStt"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="STT: 0 ms"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="8dp"
                            android:layout_margin="3dp"/>

                        <TextView
                            android:id="@+id/tvMetricNet"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Network: 0 ms"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="8dp"
                            android:layout_margin="3dp"/>

                        <TextView
                            android:id="@+id/tvMetricTts"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="TTS: 0 ms"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="8dp"
                            android:layout_margin="3dp"/>

                        <TextView
                            android:id="@+id/tvMetricTrans"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:text="Translation: SKIPPED"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:background="@drawable/bg_metric_tile"
                            android:padding="8dp"
                            android:layout_margin="3dp"/>
                    </GridLayout>

                    <!-- E2E Latency Banner -->
                    <TextView
                        android:id="@+id/tvMetricE2e"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="E2E: 0 ms"
                        android:textColor="@color/state_green"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:background="@drawable/bg_metric_tile"
                        android:padding="8dp"
                        android:layout_marginTop="6dp"/>

                    <!-- Bandwidth Savings Banner (1000x proof) -->
                    <TextView
                        android:id="@+id/tvMetricBandwidth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sent: 0 B · PCM: 0 B (0.0% saved)"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:background="@drawable/bg_badge_local"
                        android:padding="8dp"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bottom Action Controls: Push-to-Talk & Alert -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- PTT State Indicator -->
                <TextView
                    android:id="@+id/tvPttState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/state_ready"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- PTT Button: Big, Hold-To-Speak -->
                <Button
                    android:id="@+id/btnPtt"
                    android:layout_width="220dp"
                    android:layout_height="72dp"
                    android:text="@string/btn_hold_to_speak"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_inverse"
                    android:background="@drawable/bg_ptt_idle"
                    android:elevation="4dp"
                    android:enabled="false"
                    android:layout_marginBottom="14dp"/>

                <!-- Emergency Alert Toggle Button -->
                <Button
                    android:id="@+id/btnAlert"
                    android:layout_width="160dp"
                    android:layout_height="44dp"
                    android:text="@string/btn_send_alert"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/state_red"
                    android:background="@drawable/bg_alert_btn"
                    style="@style/Widget.MaterialComponents.Button"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
