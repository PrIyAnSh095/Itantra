<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvModelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hindi STT (IndicConformer)"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvModelDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stt_hi.onnx · INT8 · 75 MB"
            android:textColor="@color/text_muted"
            android:textSize="11sp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvModelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/model_not_installed"
        android:textColor="@color/state_orange"
        android:textSize="12sp"
        android:textStyle="bold"/>
</LinearLayout>
